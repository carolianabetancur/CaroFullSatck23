//------------------------------------------------------------------------------------------------------

//“Pproductos cuyo precio sea mayor a 400.”
db('TecnologyShop')
  .collection('products')
  .find({ price: { $gt: 400 } }, { name: 1, price: 1, stock: 1, _id: 0 });

//“Quiero productos cuyo precio sea mayor o igual a 300 Y cuyo stock sea menor o igual a 15.”
db('TecnologyShop')
  .collection('products')
  .find(
    { price: { $gte: 300 }, stock: { $lte: 15 } },
    { name: 1, price: 1, stock: 1, _id: 0 },
  );

//“Quiero pedidos que estén pending O cancelled.”
db('TecnologyShop')
  .collection('orders')
  .find(
    {
      $or: [
        {
          status: 'pending',
        },
        {
          status: 'cancelled',
        },
      ],
    },
    {
      status: 1,
      total: 1,
      createdAt: 1,
      _id: 0,
    },
  );

//Traer órdenes con total mayor a 700, ordenarlas de mayor a menor por total y mostrar solo status, total y createdAt.
db('TecnologyShop')
  .collection('orders')
  .aggregate([
    { $match: { total: { $gt: 700 } } },
    { $sort: { total: -1 } },
    { $project: { status: 1, total: 1, createdAt: 1, _id: 0 } },
  ]);

//“¿Cuántas órdenes tenemos por cada estado?”
db('TecnologyShop')
  .collection('orders')
  .aggregate([
    {
      $group: { _id: '$status', cantidad: { $sum: 1 } },
    },
    { $sort: { cantidad: -1 } },
    { $project: { _id: 0, estado: '$_id', cantidad: 1 } },
  ]);

//Quiero ver cada producto vendido como una fila independiente, aunque originalmente esté dentro del array products
db('TecnologyShop')
  .collection('orders')
  .aggregate([
    { $unwind: '$products' },
    {
      $project: {
        _id: 0,
        'products.name': 1,
        'products.quantity': 1,
        'products.unitPrice': 1,
        status: 1,
      },
    },
  ]);

//¿Cuántas unidades se han vendido de cada producto en todas las órdenes?
db('TecnologyShop')
  .collection('orders')
  .aggregate([
    { $unwind: '$products' },
    {
      $group: {
        _id: '$sproducts.name',
        totalUnidades: { $sum: '$products.quantity' },
      },
    },
    { $sort: { totalUnidades: -1 } },
    {
      $project: { _id: 0, producto: '$_id', totalUnidades: 1 },
    },
  ]);

//¿Cuánto dinero se ha vendido por cada producto?”
db('TecnologyShop')
  .collection('orders')
  .aggregate([
    { $unwind: '$products' },
    {
      $group: {
        _id: '$products.name',
        totalSold: {
          $sum: {
            $multiply: ['$products.quantity', '$products.unitPrice'],
          },
        },
      },
    },
    { $sort: { totalSold: -1 } },
    {
      $project: { _id: 0, producto: '$_id', totalSold: 1 },
    },
  ]);

//¿Cuánto dinero ha comprado cada usuario?
// agrupa todas las órdenes del mismo userId;
// suma todos los total;
// para name, toma el primer nombre encontrado dentro de ese grupo;
// para lastName, toma el primer apellido encontrado.
// ¿Por qué sirve aquí? Porque todas las órdenes de un mismo userId deberían corresponder al mismo usuario, así que el nombre será el mismo en todas.
db('TecnologyShop')
  .collection('orders')
  .aggregate([
    {
      $lookup: {
        from: 'users',
        localField: 'userId',
        foreignField: '_id',
        as: 'userData',
      },
    },
    { $unwind: '$userData' },
    {
      $group: {
        _id: '$userId',
        name: { $first: '$userData.name' },
        lastName: { $first: '$userData.lastName' },
        totalPurchased: { $sum: '$total' },
      },
    },
    { $sort: { totalPurchased: -1 } },
    {
      $project: {
        _id: 0,
        name: 1,
        lastName: 1,
        totalPurchased: 1,
      },
    },
  ]);

//¿Cuánto ha comprado cada usuario, pero contando solo órdenes paid o delivered?
db('TecnologyShop')
  .collection('orders')
  .aggregate([
    {
      $match: {
        status: { $in: ['paid', 'delivered'] },
      },
    },
    {
      $lookup: {
        from: 'users',
        localField: 'userId',
        foreignField: '_id',
        as: 'userData',
      },
    },
    {
      $unwind: '$userData',
    },
    {
      $group: {
        _id: '$userId',
        name: { $first: '$userData.name' },
        lastName: { $first: '$userData.lastName' },
        totalPurchased: { $sum: '$total' },
      },
    },
    {
      $sort: {
        totalPurchased: -1,
      },
    },
    {
      $project: {
        _id: 0,
        name: 1,
        lastName: 1,
        totalPurchased: 1,
      },
    },
  ]);
