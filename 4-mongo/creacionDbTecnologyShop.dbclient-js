//Código para Mongosh, recordemos que ahí si se permite NumberDecimal
db.runCommand({
  collMod: 'orders',
  validator: {
    $jsonSchema: {
      bsonType: 'object',
      required: [
        'userId',
        'createdAt',
        'status',
        'total',
        'shippingAddress',
        'products',
      ],
      properties: {
        userId: {
          bsonType: 'objectId',
        },
        createdAt: {
          bsonType: 'date',
        },
        status: {
          bsonType: 'string',
          enum: ['pending', 'paid', 'shipped', 'delivered', 'cancelled'],
        },
        total: {
          bsonType: 'decimal',
          minimum: NumberDecimal('0'),
        },
        shippingAddress: {
          bsonType: 'object',
          required: ['street', 'city', 'state', 'postalCode'],
          properties: {
            street: {
              bsonType: 'string',
            },
            city: {
              bsonType: 'string',
            },
            state: {
              bsonType: 'string',
            },
            postalCode: {
              bsonType: 'string',
            },
          },
        },
        products: {
          bsonType: 'array',
          minItems: 1,
          items: {
            bsonType: 'object',
            required: ['productId', 'name', 'quantity', 'unitPrice'],
            properties: {
              productId: {
                bsonType: 'objectId',
              },
              name: {
                bsonType: 'string',
                minLength: 3,
                maxLength: 50,
              },
              description: {
                bsonType: 'string',
              },
              quantity: {
                bsonType: 'int',
                minimum: 1,
              },
              unitPrice: {
                bsonType: 'decimal',
                minimum: NumberDecimal('0'),
                exclusiveMinimum: true,
              },
            },
          },
        },
      },
    },
  },
  validationLevel: 'strict',
  validationAction: 'error',
});

