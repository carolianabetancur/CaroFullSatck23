//Para los precios la idea es siempre usar NumberDecimal, pero ese se usa en la terminal o en compass, aquí toca usar Decimal128
db('TecnologyShop').createCollection('products', {
  validator: {
    $jsonSchema: {
      bsonType: 'object',
      required: ['name', 'price', 'stock', 'createdAt', 'categories'],
      properties: {
        name: {
          bsonType: 'string',
          minLength: 1,
          maxLength: 75,
          description: 'debe ser un string y es obligatorio',
        },
        description: {
          bsonType: 'string',
          description: 'debe ser un string',
        },
        price: {
          bsonType: 'double',
          minimum: 0,
          description: 'debe ser un decimal y es obligatorio',
        },
        stock: {
          bsonType: 'int',
          minimum: 0,
          description: 'debe ser un entero y es obligatorio',
        },
        createdAt: {
          bsonType: 'date',
        },
        categories: {
          bsonType: 'array',
          minItems: 1,
          items: {
            bsonType: 'objectId',
          },
        },
      },
    },
  },
});

db('TecnologyShop').command({
  collMod: 'products',
  validator: {
    $jsonSchema: {
      bsonType: 'object',
      required: ['name', 'price', 'stock', 'createdAt', 'categories'],
      properties: {
        name: {
          bsonType: 'string',
          minLength: 1,
          maxLength: 75,
        },
        description: {
          bsonType: 'string',
        },
        price: {
          bsonType: 'number',
          minimum: 0,
        },
        stock: {
          bsonType: 'number',
          minimum: 0,
          multipleOf: 1,
        },
        createdAt: {
          bsonType: 'date',
        },
        categories: {
          bsonType: 'array',
          minItems: 1,
          items: {
            bsonType: 'objectId',
          },
        },
      },
    },
  },
  validationLevel: 'strict',
  validationAction: 'error',
});

db('TecnologyShop').createCollection('categories', {
  validator: {
    $jsonSchema: {
      bsonType: 'object',
      required: ['categoryName'],
      properties: {
        categoryName: {
          bsonType: 'string',
          minLength: 1,
          maxLength: 50,
          description: 'debe ser un string y es obligatorio',
        },
        description: {
          bsonType: 'string',
          description: 'debe ser un string',
        },
      },
    },
  },
});

//categoryName: 1, ese 1 significa que el índice se construye en orden ascendente sobre categoryName
db('TecnologyShop')
  .collection('categories')
  .createIndex({ categoryName: 1 }, { unique: true });

db('TecnologyShop').createCollection('orders', {
  validator: {
    $jsonSchema: {
      bsonType: 'object',
      required: [
        'userId',
        'createdAt',
        'status',
        'total',
        'shippingAddress',
        'products',
      ],
      properties: {
        userId: {
          bsonType: 'objectId',
        },
        createdAt: {
          bsonType: 'date',
        },
        status: {
          bsonType: 'string',
          enum: ['pending', 'paid', 'shipped', 'delivered', 'cancelled'],
          description:
            'Debe ser uno de los siguientes valores: pending, paid, shipped, delivered, cancelled',
        },
        total: {
          bsonType: 'decimal',
          minimum: 0,
          description: 'debe ser un decimal y es obligatorio',
        },
        shippingAddress: {
          bsonType: 'object',
          required: ['street', 'city', 'state', 'postalCode'],
          properties: {
            street: {
              bsonType: 'string',
            },
            city: {
              bsonType: 'string',
            },
            state: {
              bsonType: 'string',
            },
            postalCode: {
              bsonType: 'string',
            },
          },
        },
        products: {
          bsonType: 'array',
          minItems: 1,
          items: {
            bsonType: 'object',
            required: ['productId', 'name', 'quantity', 'unitPrice'],
            properties: {
              productId: {
                bsonType: 'objectId',
                description: 'debe ser un objectId y es obligatorio',
              },
              name: {
                bsonType: 'string',
                minLength: 3,
                maxLength: 50,
                description: 'debe ser un string y es obligatorio',
              },
              description: {
                bsonType: 'string',
                description: 'debe ser un string',
              },
              quantity: {
                bsonType: 'int',
                minimum: 1,
                description: 'debe ser un entero y es obligatorio',
              },
              unitPrice: {
                bsonType: 'decimal',
                //Esto sería el equivalente a mayor que 0
                exclusiveMinimum: 0,
                description: 'debe ser un decimal y es obligatorio',
              },
            },
          },
        },
      },
    },
  },
});

//La idea base es esta: un índice sirve para que MongoDB encuentre documentos más rápido, sin tener que revisar toda la colección uno por uno.
db('TecnologyShop')
  .collection('orders')
  .createIndex({ userId: 1, createdAt: -1 });
db('TecnologyShop').collection('orders').createIndex({ status: 1 });
db('TecnologyShop').collection('orders').createIndex({ createdAt: -1 });

