  .collection('electrodomesticos')
  .insertMany([
    {
      nombre: 'Nevera',
      marca: 'Samsung',
      atributos: {
        capacidad: '28 pies cúbicos',
        color: 'frost-free',
        energia: 'A++',
      },
    },
    {
      nombre: 'Televisor',
      marca: 'Sony',
      atributos: {
        pulgadas: 55,
        resolucion: '4K',
        smart: true,
      },
    },
    {
      nombre: 'Computador',
      marca: 'Dell',
      atributos: {
        procesador: 'Intel Core i7',
        ram: '16GB',
        almacenamiento: '512GB SSD',
      },
    },
  ]);

//Uno a millones, es manejado por el patrón bucket. Almaceno en pequeños cubos la info que es mucha.
//Ejemplo: quiero conocer el registro del comportamiento de los usuarios en una plataforma educativa. Como esto se vuelve
//insostenible, la idea es crear la estructura para que se llene automáticamente

db('Libreria')
  .collection('estudiante')
  .insertOne({
    nombre: 'Juan Perez',
    edad: 20,
    carrera: 'Ingenieria de sistemas',
    comportamiento: [
      {
        hora: '10:00',
        descripcion: 'reproduccion de video',
      },
      {
        hora: '10:05',
        descripcion: 'modulo de tareas',
      },
    ],
  });

//Relaciones por referncias lo podemos hacer desde Data Modeling en compass y ahí tendremos primary key, foreign y podemos tener
