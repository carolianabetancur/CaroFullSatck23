db('Libreria')
  .collection('cliente')
  .updateOne({ nombre: 'Camila' }, { $set: { 'direccion.numero': 456 } });

//Arreglos o vectores. Mongo dentro de un documento admite arrays o vectores, es decir, un campo puede contener varios valores.
// Por ejemplo, podemos tener un campo "telefonos" que contenga varios números de teléfono para un cliente.
db('Libreria')
  .collection('cliente')
  .insertMany([
    {
      nombre: 'Maria',
      apellido: 'Lopez',
      intereses: ['lectura', 'viajes', 'deportes'],
    },
    {
      nombre: 'Gabriel',
      apellido: 'Ramirez',
      intereses: ['musica', 'cine', 'libros'],
    },
  ]);

db('Libreria').collection('cliente').find();

// La ventaja de usar arreglos es que para insertar información podríamos hacerlo a partir de funciones.
// Dónde push es una función para agregar nuevos elementos, al final
db('Libreria')
  .collection('cliente')
  .updateOne({ nombre: 'Gabriel' }, { $push: { intereses: 'cocina' } });

db('Libreria')
  .collection('cliente')
  .updateOne(
    { nombre: 'Gabriel' },
    { $push: { intereses: { $each: ['ajedrez', 'guitarra'] } } },
  );
db('Libreria').collection('cliente').find();

db('Libreria').createCollection('productos');
db('Libreria')
  .collection('productos')
  .insertMany([
    {
      nombre: 'Laptop',
      categorias: ['tecnologia', 'computadoras'],
      stock: 15,
      precio: 1000,
    },
    {
      nombre: 'Teclado',
      categorias: ['tecnologia', 'accesorios'],
      stock: 30,
      precio: 25,
    },
    {
      nombre: 'Mesa',
      categorias: ['mobiliario', 'accesorios'],
      stock: 10,
      precio: 150,
    },
  ]);

db('Libreria')
  .collection('productos')
  .updateOne({ nombre: 'Mesa' }, { $set: { 'categorias.1': 'hogar' } });

db('Libreria').createCollection('ordenes');

db('Libreria')
  .collection('ordenes')
  .insertMany([
    {
      cliente: 'Juan',
      productos: [{ nombre: 'Laptop', cantidad: 1, precio: 1000 }],
      total: 1000,
    },
    {
      cliente: 'Ana',
      productos: [{ nombre: 'Mesa', cantidad: 1, precio: 150 }],
      total: 150,
    },
  ]);

db('Libreria').createCollection('ventas');

