//Es posible crear una collección con ciertas restricciones y se hace de esta forma. Cuando llegue al máximo borra los primeros documentos
//En el validator van los tipos de datos y los campos requeridos

db('Libreria').createCollection('materia', {
  capped: true,
  size: 100000,
  max: 1000,
  validator: {
    $jsonSchema: {
      bsonType: 'object',
      required: ['nombre', 'creditos', 'horario', 'profesor'],
      properties: {
        nombre: {
          bsonType: 'string',
        },
        creditos: {
          bsonType: 'int',
          minimum: 1,
          maximum: 4,
        },
      },
    },
  },
  // validationLevel: 'strict',
});

db('Libreria').collection('materia').insertOne({
  nombre: 'Matemáticas',
  creditos: 2,
  horario: 'Lunes y Miércoles 10:00-12:00',
  profesor: 'Dr. Juan Pérez',
});

db('Libreria').collection('materia').drop();

//Relaciones en Mongo db
//Uno a uno puede ser de referencia o embebidos

//Relación uno a uno con obejetos embebidos. Una materia le corresponde el objeto profesor, es uno a uno y es embebido. Lo mas normal
//en mongo son los datos embebidos(se recomienda cuando no son muchos datos), por qué con las referencias es mas complejo
//Mongo permite desnormalizar, ya que busca mas temas de rapidez
db('Libreria')
  .collection('materia')
  .insertOne({
    nombre: 'Matemáticas',
    creditos: 2,
    horario: 'Lunes y Miércoles 10:00-12:00',
    profesor: {
      nombre: 'Dr. Juan Pérez',
      correo: 'juan.perez@universidad.edu',
    },
  });

