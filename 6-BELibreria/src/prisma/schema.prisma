generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//@id indica que es la llave primaria
model book{
id Int @id @default(autoincrement())
name String
year Int
}

model author{
id Int @id @default(autoincrement())
name String
correo String
}

model user{
id Int @id @default(autoincrement())
name String
correo String
password String
}

